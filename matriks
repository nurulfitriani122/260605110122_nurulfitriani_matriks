public class matriks {
    public static void main(String[] args) {
        int[][] matriksA = {
            {1, 2},
            {4, 5},
            {7, 8}
        };

        int[][] matriksB = {
            {9, 8},
            {6, 5},
            {3, 2}
        };

        int[][] hasilPenjumlahan = new int[3][2];

        // Penjumlahan matriks
        for (int i = 0; i < 3; i++) {
            for (int j = 0; j < 2; j++) {
                hasilPenjumlahan[i][j] = matriksA[i][j] + matriksB[i][j];
            }
        }

        
        System.out.println("Hasil Penjumlahan Matriks A dan B:");
        for (int i = 0; i < 3; i++) {
            for (int j = 0; j < 2; j++) {
                System.out.print(hasilPenjumlahan[i][j] + " ");
            }
            System.out.println();
        }
    }

}
